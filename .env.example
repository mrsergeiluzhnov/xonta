# Публичный адрес оркестратора (без слеша в конце). От него строится DID эмитента: did:web:passport.xonta.ru
PUBLIC_URL=https://passport.xonta.ru
# Ключ администратора и ключ регистрации агентов — длинные случайные строки (openssl rand -hex 32)
ADMIN_TOKEN=
REGISTRATION_TOKEN=
# Открытая регистрация без ключа (лимиты: OPEN_REG_PER_IP агентов в сутки с адреса, MAX_AGENTS всего)
OPEN_REGISTRATION=1
OPEN_REG_PER_IP=5
MAX_AGENTS=1000
# Предел вызовов агента через шлюз с одного адреса в минуту (0 — без предела)
GW_RATE_PER_MIN=300
# Секрет для HMAC-отпечатков владельцев (ИНН и т. п. не хранятся) — openssl rand -hex 32
OWNER_HMAC_SECRET=
# Уведомления владельцам в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=
# Число обратных прокси перед сервисом (nginx = 1)
TRUST_PROXY=1
# Только для разработки: http и локальные адреса. В рабочем режиме не задавать!
# ALLOW_PRIVATE_TARGETS=1
