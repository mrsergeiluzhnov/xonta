# Xonta Gate in front of a small demo MCP server, so it starts without keys or network.
# To put the gate in front of your own server, change the command after "--".
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production XONTA_GATE_DIR=/tmp/xonta-gate
COPY package*.json ./
RUN npm ci --omit=dev
COPY src ./src
COPY bin ./bin
COPY skills ./skills
COPY examples ./examples
USER node
CMD ["node", "bin/xonta-gate.js", "--", "node", "examples/demo-notes-mcp.js"]
