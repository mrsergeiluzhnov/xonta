{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocx:schema:2026-11-06:signal.schema.json",
  "title": "OCX signal",
  "type": "object",
  "required": [
    "ocx",
    "type",
    "id",
    "issuer",
    "issued_at",
    "expires_at",
    "subject",
    "category",
    "claim",
    "evidence_level",
    "evidence",
    "relay",
    "signature"
  ],
  "properties": {
    "ocx": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "type": {
      "enum": [
        "conduct.violation",
        "conduct.attestation",
        "conduct.retraction"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+#[0-9A-Za-z-]+$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:.+|a2a:https://.+|erc8004:.+|fp:sha256:[0-9a-f]{64})$"
        },
        "agent_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(did:[a-z0-9]+:.+|a2a:https://.+|erc8004:.+|fp:sha256:[0-9a-f]{64})$"
          }
        },
        "owner": {
          "type": "string",
          "pattern": "^(did:[a-z0-9]+:.+|a2a:https://.+|erc8004:.+|fp:sha256:[0-9a-f]{64})$"
        },
        "owner_verified": {
          "enum": [
            "domain",
            "signature",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": [
        "proven",
        "strong",
        "suspected"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "ledger_mismatch",
              "outcome_mismatch",
              "canary_hit",
              "policy_violation",
              "behavioral_anomaly",
              "peer_report"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "issuer_limits": {
      "type": "object",
      "properties": {
        "max_payment": {
          "type": "object",
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 8
            }
          },
          "additionalProperties": false
        },
        "human_confirmation": {
          "type": "boolean"
        },
        "counterparties": {
          "enum": [
            "any",
            "known_only",
            "none"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "irreversible_actions": {
          "type": "boolean"
        }
      }
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^#]+#[0-9A-Za-z-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string"
    },
    "relay": {
      "type": "object",
      "required": [
        "hops",
        "max_hops",
        "path"
      ],
      "properties": {
        "hops": {
          "type": "integer",
          "minimum": 0
        },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "appeal": {
      "type": "string",
      "format": "uri"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "conduct.violation"
          }
        }
      },
      "then": {
        "required": [
          "appeal"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "conduct.retraction"
          }
        }
      },
      "then": {
        "required": [
          "supersedes",
          "reason"
        ],
        "properties": {
          "supersedes": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[^#]+#[0-9A-Za-z-]+$"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
