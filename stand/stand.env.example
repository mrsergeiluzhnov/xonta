# --- Языковая модель (обязательно) ---
# Вариант 1: YandexGPT через OpenAI-совместимый API (работает с российского сервера)
LLM_PROVIDER=openai
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_FOLDER_ID=
# модель агентов (дешевле) и модель судьи (сильнее); подставьте свой каталог вместо <folder>
AGENT_MODEL=gpt://<folder>/yandexgpt-5-lite
JUDGE_MODEL=gpt://<folder>/yandexgpt-5.1
# Вариант 2: Anthropic (если API доступен с сервера)
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# AGENT_MODEL=claude-haiku-4-5
# JUDGE_MODEL=claude-sonnet-4-5

# Жёсткие бюджеты токенов: при исчерпании вызовы прекращаются
# YandexGPT Lite — 0,2 ₽, Pro 5.1 — 0,8 ₽ за 1000 токенов: 2 млн токенов агента ≈ 400 ₽, 1,5 млн судьи ≈ 1200 ₽ (верхние пределы)
AGENT_LLM_BUDGET_TOKENS=2000000
ORCH_LLM_BUDGET_TOKENS=1500000

# --- Площадки ---
# фаза 1: агент сам собирает отзывы здесь; с 11-го раунда поставщик приносит полные отзывы otzovik и пробует остальные площадки
PHASE1_PLATFORM=otzovik
SUPPLIER_PLATFORMS=otzovik_full,market,irecommend,ozon,wildberries,mvideo
FULL_REVIEWS_PER_PRODUCT=12
# категории оценки во 2-й фазе: goods (товары) или platform (площадки)
PHASE2_MODE=goods

# --- Раунды ---
PHASE1_ROUNDS=10
TOTAL_ROUNDS=20
PRODUCTS_PER_ROUND=3
# пауза между раундами, минут (сбор идёт медленно и вежливо; 0 — без пауз)
ROUND_PAUSE_MIN=30
FEEDBACK_BUDGET=4
SKILL_EXAMPLE_LIMIT=8
MAX_CHILDREN=4

# Пороги сигнала «родить специалиста»: доля категории в трафике и отставание от лучшей категории, п.п.
SIGNAL_C_MIN_SHARE=0.1
SIGNAL_C_GAP=10

# --- Сбор страниц: не чаще раза в 8 с на площадку, не больше 300 страниц в сутки ---
FETCH_INTERVAL_MS=8000
FETCH_DAILY_LIMIT=300
MAX_PAGES=2
